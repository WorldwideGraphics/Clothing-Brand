---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search the Collection — Ahmad Emporium">
  <section class="search-page section">
    <div class="container">
      <p class="kicker">Our collection</p>
      <h1 id="searchHeading">Search the collection</h1>
      <p id="searchStatus" class="section-sub" aria-live="polite">Search by item, collection, fabric, or work. Results appear 24 at a time.</p>
      <form class="catalogue-search" action="/search/" method="get" role="search">
        <label class="sr-only" for="catalogueSearchInput">Search the collection</label>
        <input id="catalogueSearchInput" name="q" type="search" placeholder="Try “chikankari” or “saree”" autocomplete="off" />
        <button class="btn btn-primary btn-sm" type="submit">Search</button>
      </form>
      <div id="searchResults" class="product-grid search-results"></div>
      <div class="favourites-more">
        <button id="searchLoadMore" class="btn btn-outline" type="button" hidden>Show more results</button>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/search-page.js';
  </script>
</BaseLayout>
