---
import { CATEGORIES, getSubcategoriesByCategory } from '../data/products.js';

const categoryMenus = CATEGORIES.map(category => ({
  ...category,
  subcategories: getSubcategoriesByCategory(category.slug),
}));
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <img src="/images/logo-icon.png" alt="Ahmad Emporium" class="logo-mark" />
      <span class="logo-text">AHMAD EMPORIUM<small>FASHION HOUSE</small></span>
    </a>
    <nav class="main-nav" id="mainNav" aria-label="Primary navigation">
      <a href="/#hero">Home</a>
      {categoryMenus.map(category => (
        <details class="nav-dropdown">
          <summary>{category.name}</summary>
          <div class="dropdown-menu">
            <a href={`/category/${category.slug}/`}>All {category.name}</a>
            {category.subcategories.map(subcategory => (
              <a href={`/category/${category.slug}/${subcategory.slug}/`}>{subcategory.name}</a>
            ))}
          </div>
        </details>
      ))}
    </nav>
    <div class="header-actions">
      <button class="search-toggle" type="button" aria-label="Search the collection" aria-controls="headerSearch" aria-expanded="false">
        <svg aria-hidden="true"><use href="#icon-search"/></svg>
      </button>
      <button class="nav-toggle" type="button" aria-label="Toggle menu" aria-controls="mainNav" aria-expanded="false"><span></span><span></span><span></span></button>
    </div>
  </div>
  <form id="headerSearch" class="header-search" action="/search/" method="get" role="search" hidden>
    <div class="container header-search-inner">
      <label class="sr-only" for="headerSearchInput">Search the collection</label>
      <svg aria-hidden="true"><use href="#icon-search"/></svg>
      <input id="headerSearchInput" name="q" type="search" placeholder="Search our collection" autocomplete="off" />
      <button class="search-submit" type="submit">Search</button>
      <button class="search-close" type="button" aria-label="Close search">&times;</button>
    </div>
  </form>
</header>
