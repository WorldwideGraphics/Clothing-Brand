---
const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo">
        <img src="/images/logo-icon.png" alt="Ahmad Emporium" class="logo-mark logo-mark-lg" />
        <span class="logo-text light">AHMAD EMPORIUM<small>FASHION HOUSE</small></span>
      </a>
      <p>An exclusive doorstep couture experience — handcrafted weaves, bridal trousseaus and heirloom silks brought straight to your home.</p>
      <div class="social-row">
        <a href="https://www.instagram.com/ahmademporium/" target="_blank" rel="noopener" aria-label="Instagram"><svg><use href="#icon-instagram"/></svg></a>
        <a href="https://www.facebook.com/share/1KCvQpmhXY/?mibextid=wwXIfr" target="_blank" rel="noopener" aria-label="Facebook"><svg><use href="#icon-fb"/></svg></a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Experience</h4>
      <a href="/#reserve">Book Mobile Boutique</a>
      <a href="/#collections">Shop Online</a>
      <a href="/#process">How It Works</a>
      <a href="/#reserve">Reserve a Slot</a>
    </div>

    <div class="footer-col">
      <h4>Artisanal Craft</h4>
      <a href="/category/lucknowi-chikankari/">Lucknowi Chikankari</a>
      <a href="/category/lehenga/">Bridal Lehengas</a>
      <a href="/category/anarkali-peshwas/">Anarkali Suits</a>
      <a href="/category/saree/">Sarees</a>
    </div>

    <div class="footer-col">
      <h4>Service Promise</h4>
      <a href="/#why-visit">Zero Traffic Shopping</a>
      <a href="/#why-visit">On-Site Master Tailor</a>
      <a href="/#why-visit">7-Day Easy Returns</a>
      <a href="/#why-visit">Family-Safe Private Visits</a>
    </div>

    <div class="footer-col footer-contact">
      <h4>Reach Us</h4>
      <p><svg><use href="#icon-pin"/></svg> Main Gulberg, Lahore, Punjab, Pakistan</p>
      <a class="footer-contact-link" href="tel:+923019680037"><svg><use href="#icon-phone"/></svg> +92 301 9680037</a>
      <a class="footer-contact-link" href="mailto:concierge@ahmademporium.co"><svg><use href="#icon-mail"/></svg> concierge@ahmademporium.co</a>
      <p class="footer-email-note"><a href="mailto:concierge@ahmademporium.co?subject=New%20arrivals">Email us to hear about new arrivals</a></p>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} Ahmad Emporium. All Rights Reserved.</p>
    <div class="footer-bottom-links">
      <a href="/sitemap/">Sitemap</a>
    </div>
  </div>
</footer>

<button class="to-top" id="toTop" aria-label="Back to top">&uarr;</button>
